# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# visual studio code
.vscode/*
*.code-workspace

# docs
/docs/ROADMAP.md

# private — anything matching these patterns is unconditionally ignored
# so commercial / strategic notes can't accidentally enter the repo.
# Real private content lives at ~/devel/oils-v3-private/ (outside this repo).
.private/
**/.private/
*.private
*.private.md
PLAN-PRIVATE*
PRIVATE-*