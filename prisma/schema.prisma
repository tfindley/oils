generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OilType {
  ESSENTIAL
  CARRIER
}

enum PairingRating {
  EXCELLENT
  GOOD
  CAUTION
  AVOID
  UNSAFE
}

enum UserRole {
  USER
  ADMIN
}

// Auth.js v5 + Prisma adapter conventions. Migration is purely additive;
// anonymous blends keep working unchanged in v1.1.0.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?   // null when only OAuth providers are linked
  firstName     String                          // required at signup
  lastName      String                          // required at signup
  name          String?                         // display name; user picks how it's formatted
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  blends   Blend[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // "oauth" | "oidc" | "email" | "credentials"
  provider          String  // "google" | "microsoft" | "github" | "credentials"
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String   // email address for verify; userId for password reset
  token      String   @unique
  expires    DateTime
  purpose    String   @default("EMAIL_VERIFY")  // "EMAIL_VERIFY" | "PASSWORD_RESET"

  @@unique([identifier, token])
  @@index([identifier])
}

model Oil {
  id                String   @id @default(cuid())
  name              String   @unique
  botanicalName     String
  type              OilType
  origin            String
  history           String   @db.Text
  description       String   @db.Text
  benefits          String[]
  contraindications String[]
  aroma             String
  consistency       String?
  absorbency        String?
  shelfLifeMonths   Int?
  dilutionRateMax   Float?
  buyUrl            String?
  imageUrl          String?
  imageAlt          String?
  enrichedAt        DateTime?
  enrichmentModel   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pairsWithA       OilPairing[]     @relation("OilA")
  pairsWithB       OilPairing[]     @relation("OilB")
  blendIngredients BlendIngredient[]
}

model OilPairing {
  id     String        @id @default(cuid())
  oilAId String
  oilBId String
  rating PairingRating @default(GOOD)
  reason String

  oilA Oil @relation("OilA", fields: [oilAId], references: [id], onDelete: Cascade)
  oilB Oil @relation("OilB", fields: [oilBId], references: [id], onDelete: Cascade)

  @@unique([oilAId, oilBId])
}

model Blend {
  id             String    @id @default(cuid())
  name           String
  description    String?
  totalVolumeMl  Float
  dilutionRate   Float
  purpose        String?
  notes          String?
  grade          String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  viewCount      Int       @default(0)
  lastAccessedAt DateTime?
  authorName     String?   // legacy: freetext set by admin on promoted blends
  about          String?   @db.Text
  isFeatured     Boolean   @default(false)
  isPinned       Boolean   @default(false)
  isHidden       Boolean   @default(false)

  // v1.2.0 ownership. userId is null for anonymous saves (pre-v1.2 + saves
  // when /admin/settings allowAnonymousSaves is on). Anonymous blends are
  // always reachable via their URL — isShared only gates owned blends.
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  isShared Boolean  @default(false)

  ingredients BlendIngredient[]

  @@index([userId])
}

model BlendIngredient {
  id            String @id @default(cuid())
  blendId       String
  oilId         String
  percentagePct Float
  volumeMl      Float

  blend Blend @relation(fields: [blendId], references: [id], onDelete: Cascade)
  oil   Oil   @relation(fields: [oilId], references: [id], onDelete: Restrict)

  @@unique([blendId, oilId])
}

// Single-row site settings. Always upserted/read via id="singleton".
model Settings {
  id                    String   @id @default("singleton")
  tooltipsEnabled       Boolean  @default(true)
  issueReportingEnabled Boolean  @default(true)
  allowAnonymousSaves   Boolean  @default(true)
  // When false, the legacy ADMIN_SECRET cookie path is rejected and
  // /admin/login is hidden. Set to false once user-based ADMIN access is
  // verified to working. Recoverable via FORCE_LEGACY_ADMIN_LOGIN=1 env var.
  legacyAdminEnabled    Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}
