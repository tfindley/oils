# Database
DATABASE_URL="postgresql://oils:oils@localhost:5432/oils"

# Public base URL (used in PDF QR codes and shareable blend links)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Site display name — shown in the header, footer, page titles, and PDF
# Change this to brand your deployment (e.g. "My Aromatherapy Studio")
NEXT_PUBLIC_SITE_NAME="Oil Blender"

# Admin panel password — set to any strong secret value
# Used by the legacy /admin/login form. Can be disabled via the admin Settings
# page (Site Settings → Legacy admin login) once at least one User account has
# the ADMIN role and you've verified you can sign in that way.
ADMIN_SECRET="change-me"

# Emergency override — re-enables legacy /admin/login even when the Settings
# toggle is OFF. Use only if you lose user-based admin access (e.g. lost
# password, OAuth provider outage). Set to "1", restart the container, recover,
# then unset and restart again.
# FORCE_LEGACY_ADMIN_LOGIN=""

# Cron secret — set to any strong secret value
# Shared by all cron endpoints:
#   /api/cron/purge          — deletes anonymous blends inactive >30 days
#   /api/cron/account-purge  — warns and deletes user accounts inactive >1 year
CRON_SECRET="change-me"

# Google Analytics 4 Measurement ID (optional)
# Omit or leave blank to disable analytics entirely
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Anthropic API key — required to run AI enrichment (npm run enrich / Admin → Database)
# Not needed for normal operation or seeding; set to enable the Enrich button in the admin panel
ANTHROPIC_API_KEY=""

# ─── User accounts (v1.1.0+) ──────────────────────────────────────────────────

# Auth.js session secret — used to sign session cookies. REQUIRED in production.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Email transport (for signup verification, password reset).
# Pick ONE of the two transports below. In production at least one must be set.
# In dev, neither is required — emails are logged to the server console.

# Option A — Resend (recommended; free tier covers most use)
# Get a key at https://resend.com — set the API key and verify your sending domain.
RESEND_API_KEY=""

# Option B — Self-host SMTP (used only if RESEND_API_KEY is unset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# "From" address shown on outbound mail. Should match a verified domain on
# whichever transport you chose.
EMAIL_FROM="no-reply@your-domain.com"
